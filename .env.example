# Voight-Kampff / MQTT — compte de service dédié "pdf" (créé via le dashboard VK)
VK_URL=http://voight-kampff:8080
MQTT_HOST=mosquitto-broker
MQTT_PORT=1883
MQTT_SERVICE_USERNAME=pdf
MQTT_SERVICE_API_KEY=

# LLM (thebrain) — synthèse texte + transcription vision des pages scannées
LLM_BASE_URL=http://thebrain:8000/v1
LLM_MODEL=google/gemma-4-12B-it-qat-w4a16-ct
LLAMACPP_API_KEY=

# Cache / RAG
CACHE_FILE=/data/cache.json
CHROMA_PATH=/data/chroma
PDF_FOLDER=/pdfs
DOC_COUNTER_INITIAL=30
COUNTER_DECREMENT_INTERVAL=86400
FOLDER_RESCAN_INTERVAL=300

# Optionnel — valeurs par défaut déjà raisonnables
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# MIN_TEXT_PER_PAGE=20
# MAX_VISION_PAGES=20
